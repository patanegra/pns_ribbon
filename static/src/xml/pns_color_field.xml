<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pns_ribbon.PnsColorField">
        <div class="o_field_pns_color d-inline-flex align-items-center gap-2 flex-wrap">
            <input type="color"
                   t-ref="picker"
                   t-att-value="hexView"
                   t-att-disabled="props.readonly"
                   t-on-input="onPickerInput"
                   t-on-change="onPickerChange"/>
            <label class="d-inline-flex align-items-center gap-1 mb-0 text-muted" style="font-size:12px;">
                <span>Opacity</span>
                <input type="range" min="0" max="100" step="1"
                       t-ref="opacity"
                       style="width:90px;"
                       t-att-value="opacityView"
                       t-att-disabled="props.readonly"
                       t-on-input="onOpacityInput"
                       t-on-change="onOpacityChange"/>
            </label>
            <input type="text"
                   t-ref="text"
                   class="o_input"
                   style="max-width:185px;"
                   t-att-value="rawValue"
                   t-att-readonly="props.readonly"
                   t-on-input="onTextInput"
                   t-on-change="onTextChange"
                   placeholder="rgba(r, g, b, a)"/>
        </div>
    </t>
</templates>
